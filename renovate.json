{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "ruff-version inputs handed to the reusable python-validation workflow (#61)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["ruff-version:\\s*[\"']?(?<currentValue>[0-9][^\"'\\s]*)[\"']?"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "ruff"
    }
  ],
  "packageRules": [
    {
      "description": "Bump the CI pin and the dev-extra pin in one PR, so they cannot drift (#61)",
      "matchPackageNames": ["ruff"],
      "groupName": "ruff"
    }
  ]
}
